+// Pure input translation shared by the Mac front end and its mapping checks.
+#pragma once
+#include "dm_input.h"
+#include <math.h>
+#include <stdint.h>
+
+typedef struct { uint64_t buttons; int32_t lx, ly, rx, ry; } dm_mac_input;
+
+static inline dm_mac_input dm_mac_keyboard(const uint8_t keys[128], int option) {
+    dm_mac_input s = {0};
+    s.lx = (keys[2] - keys[0]) * DM_STICK_MAX;   // D - A
+    s.ly = (keys[13] - keys[1]) * DM_STICK_MAX;  // W - S
+    if (keys[38] || keys[49]) s.buttons |= DM_BTN_A;     // J / Space
+    if (keys[40] || keys[53] || keys[51]) s.buttons |= DM_BTN_B; // K / Escape / Backspace
+    if (keys[32]) s.buttons |= DM_BTN_X; if (keys[34]) s.buttons |= DM_BTN_Y; // U / I
+    if (keys[3]) s.buttons |= DM_BTN_LS; if (keys[5]) s.buttons |= DM_BTN_RS; // F / G
+    if (keys[12]) s.buttons |= DM_BTN_L; if (keys[14]) s.buttons |= DM_BTN_R; // Q / E
+    if (keys[6]) s.buttons |= DM_BTN_ZL; if (keys[8]) s.buttons |= DM_BTN_ZR; // Z / C
+    if (keys[36]) s.buttons |= DM_BTN_PLUS; if (keys[48]) s.buttons |= DM_BTN_MINUS;
+    if (!option) {
+        if (keys[123]) s.buttons |= DM_BTN_LEFT; if (keys[126]) s.buttons |= DM_BTN_UP;
+        if (keys[124]) s.buttons |= DM_BTN_RIGHT; if (keys[125]) s.buttons |= DM_BTN_DOWN;
+    }
+    // Option + arrows works on a MacBook without a numeric keypad; keypad 4/6/8/2 is an alias.
+    int left = keys[86] || (option && keys[123]), right = keys[88] || (option && keys[124]);
+    int up = keys[91] || (option && keys[126]), down = keys[84] || (option && keys[125]);
+    s.rx = (right - left) * DM_STICK_MAX; s.ry = (up - down) * DM_STICK_MAX;
+    if (keys[17]) s.buttons |= DM_BTN_SHAKE; // T: optional motion-sensor shake
+    return s;
+}
+
+// GameController uses Xbox-shaped positions. Nintendo-labelled pads swap both pairs.
+static inline uint64_t dm_mac_face_buttons(int a, int b, int x, int y, int nintendo) {
+    return (a ? (nintendo ? DM_BTN_B : DM_BTN_A) : 0) |
+           (b ? (nintendo ? DM_BTN_A : DM_BTN_B) : 0) |
+           (x ? (nintendo ? DM_BTN_Y : DM_BTN_X) : 0) |
+           (y ? (nintendo ? DM_BTN_X : DM_BTN_Y) : 0);
+}
+
+static inline int32_t dm_mac_pad_axis(float value) {
+    if (!isfinite(value)) return 0;
+    float v = fmaxf(-1.f, fminf(1.f, value));
+    float magnitude = fabsf(v);
+    if (magnitude <= 0.12f) return 0;
+    return (int32_t)(copysignf((magnitude - 0.12f) / 0.88f, v) * DM_STICK_MAX);
+}
